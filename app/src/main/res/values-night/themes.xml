<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 暗色基础主题 -->
    <style name="Theme.SmartMirror" parent="Theme.AppCompat.NoActionBar">
        <!-- Material 3 桥接属性 -->
        <item name="colorPrimary">#FF64B5F6</item>
        <item name="colorPrimaryDark">#FF42A5F5</item>
        <item name="colorAccent">#FF03DAC5</item>

        <!-- 窗口 -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Compose 主题桥接 -->
        <item name="android:colorBackground">#FF101214</item>
        <item name="android:textColorPrimary">#FFE3E2E6</item>
        <item name="android:textColorSecondary">#FFC4C6CA</item>
        <item name="android:colorForeground">#FF64B5F6</item>
    </style>

    <!-- 全屏沉浸式主题 -->
    <style name="Theme.SmartMirror.Fullscreen" parent="Theme.SmartMirror">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>
